---
import { ArrowDown } from "@lucide/astro"
---

<a
    data-reveal
    data-cv
    data-cursor="Ver CV"
    href="/images/CV_Agustin_Arla_Analista_Funcional.docx.pdf"
    target="_blank"
    rel="noopener noreferrer"
    class="card group col-span-1 flex min-h-[240px] flex-col p-6 sm:col-span-2 sm:p-7 lg:col-span-4 lg:row-span-2 lg:min-h-0"
>
    <p class="card-label"><span class="num">05.</span> CV</p>

    <div class="relative z-10 mt-auto max-w-[60%]">
        <p class="text-[clamp(2rem,2.7vw,2.75rem)] font-semibold uppercase leading-[0.9] tracking-tight">
            Currículum
        </p>
        <p class="mt-3 flex items-center gap-2 text-sm text-muted">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-accent text-ink transition-transform duration-500 group-hover:translate-y-0.5">
                <ArrowDown size={15} aria-hidden="true" />
            </span>
            PDF · Analista Funcional
        </p>
        <span class="sr-only">(se abre en una pestaña nueva)</span>
    </div>

    <div data-cv-paper aria-hidden="true" class="absolute -bottom-16 right-5 w-[32%] max-w-[190px] sm:right-7">
        <div data-cv-paper-back class="absolute inset-0 rounded-lg border border-line bg-white"></div>
        <img
            data-cv-paper-front
            src="/images/cv.png"
            alt=""
            width="444"
            height="496"
            class="relative w-full rounded-lg border border-line bg-white shadow-[0_20px_40px_-20px_rgba(20,20,20,0.4)]"
            loading="lazy"
        />
    </div>
</a>

<script>
    import cvAnimation from "../script/cv.js"
    cvAnimation()
</script>
