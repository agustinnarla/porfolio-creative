---
import { Icon } from "astro-icon/components"
import { ArrowLeft, ArrowRight, ArrowUpRight, X } from "@lucide/astro"
import { projects } from "../data/projects"

const pad = (n: number) => String(n).padStart(2, "0")
---

<section
    data-reveal
    data-projects
    aria-roledescription="carrusel"
    aria-label="Proyectos"
    class="card col-span-1 flex min-h-[580px] flex-col p-4 sm:col-span-2 sm:min-h-[600px] sm:p-6 lg:col-span-7 lg:row-span-4 lg:min-h-0 lg:p-7"
>
    <div class="flex items-center justify-between gap-4">
        <h2 class="card-label"><span class="num">02.</span> Proyectos</h2>

        <div class="flex items-center gap-3">
            <p class="text-sm tabular-nums text-muted" aria-hidden="true">
                <span data-project-current class="text-ink">01</span> / {pad(projects.length)}
            </p>
            <button type="button" data-project-prev class="btn-round" aria-label="Proyecto anterior">
                <ArrowLeft size={18} aria-hidden="true" />
            </button>
            <button type="button" data-project-next class="btn-round" aria-label="Proyecto siguiente">
                <ArrowRight size={18} aria-hidden="true" />
            </button>
        </div>
    </div>

    <p data-project-live class="sr-only" aria-live="polite"></p>

    <div data-project-stack class="relative mt-5 flex-1">
        {
            projects.map((project, index) => (
                <article
                    data-project-card
                    data-cursor="Arrastrar"
                    aria-roledescription="diapositiva"
                    aria-label={`${index + 1} de ${projects.length}: ${project.title}`}
                    style={`background:${project.bg};color:${project.fg}`}
                    class="absolute inset-x-0 bottom-10 top-0 flex cursor-grab touch-pan-y select-none flex-col overflow-hidden rounded-[1.25rem] p-5 shadow-[0_30px_60px_-30px_rgba(20,20,20,0.45)] active:cursor-grabbing sm:p-7"
                >
                    {project.image ? (
                        <div
                            data-project-visual
                            aria-hidden="true"
                            class="pointer-events-none absolute right-5 top-16 w-[36%] max-w-[230px] rotate-[-6deg] sm:-bottom-24 sm:right-8 sm:top-auto sm:w-[34%]"
                        >
                            <img
                                src={project.image}
                                alt=""
                                width="540"
                                height="960"
                                draggable="false"
                                class="w-full rounded-[1.6rem] border-[6px] border-[#1d1530] shadow-2xl"
                                loading="lazy"
                            />
                        </div>
                    ) : (
                        <span
                            data-project-visual
                            aria-hidden="true"
                            class="pointer-events-none absolute -bottom-10 -right-2 font-script text-[clamp(9rem,22vw,18rem)] leading-none opacity-[0.13]"
                        >
                            {pad(project.id)}
                        </span>
                    )}

                    <div class="relative flex items-center justify-between gap-3">
                        <span class="font-script text-2xl">{pad(project.id)}.</span>
                        <span class="rounded-full border border-current/25 px-3 py-1 text-xs uppercase tracking-[0.14em]">
                            {project.type}
                        </span>
                    </div>

                    <div class="relative mt-auto max-w-[62%] sm:max-w-[60%]">
                        {project.logo && (
                            <img src={project.logo} alt="" width="56" height="56" draggable="false" class="mb-3 h-12 w-12 sm:h-14 sm:w-14" />
                        )}
                        <h3 class="text-[clamp(2rem,4.4vw,4.25rem)] font-semibold uppercase leading-[0.88] tracking-tight [overflow-wrap:anywhere]">
                            {project.title}
                        </h3>
                        <p class="mt-3 text-base opacity-75 sm:text-lg">{project.details}</p>

                        <ul class="mt-4 hidden flex-wrap gap-1.5 sm:flex">
                            {project.technologies.slice(0, 4).map((tech) => (
                                <li class="rounded-full bg-current/10 px-2.5 py-1 text-xs">{tech}</li>
                            ))}
                        </ul>

                        <button
                            type="button"
                            data-project-open={index}
                            data-cursor="Abrir"
                            aria-haspopup="dialog"
                            class="group mt-5 flex cursor-pointer items-center gap-2 rounded-full py-2 pl-4 pr-2 text-sm"
                            style={`background:${project.fg};color:${project.bg}`}
                        >
                            Ver proyecto<span class="sr-only"> {project.title}</span>
                            <span
                                class="grid h-7 w-7 place-items-center rounded-full transition-transform duration-500 group-hover:rotate-45"
                                style={`background:${project.bg};color:${project.fg}`}
                            >
                                <ArrowUpRight size={16} aria-hidden="true" />
                            </span>
                        </button>
                    </div>
                </article>
            ))
        }
    </div>

    <p class="relative z-10 -mt-6 hidden text-xs uppercase tracking-[0.14em] text-muted sm:block" aria-hidden="true">
        Arrastrá la tarjeta o usá las flechas
    </p>
</section>

<dialog data-project-modal class="modal" aria-labelledby="project-modal-title">
    <div data-modal-backdrop class="absolute inset-0 bg-ink/55 backdrop-blur-md"></div>

    <div
        data-modal-panel
        class="relative m-4 grid max-h-[calc(100svh-2rem)] w-full max-w-5xl overflow-y-auto rounded-[1.75rem] bg-card md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:overflow-hidden"
    >
        <button type="button" data-modal-close aria-label="Cerrar" class="btn-round absolute right-5 top-5 z-10">
            <X size={20} aria-hidden="true" />
        </button>

        <div
            data-modal-media
            class="relative flex min-h-[260px] items-center justify-center overflow-hidden p-6 md:min-h-[540px]"
        >
        </div>

        <div class="flex flex-col p-6 sm:p-10 md:overflow-y-auto">
            <p data-modal-stagger class="card-label">
                <span data-modal-number class="num"></span>
                <span data-modal-type></span>
            </p>

            <h2
                id="project-modal-title"
                data-modal-stagger
                data-modal-title
                class="mt-3 pr-12 text-4xl font-semibold uppercase leading-[0.9] tracking-tight sm:text-5xl"
            >
            </h2>

            <p data-modal-stagger data-modal-description class="mt-6 text-base leading-relaxed text-muted sm:text-lg"></p>

            <ul data-modal-stagger data-modal-technologies class="mt-6 flex flex-wrap gap-2"></ul>

            <div data-modal-stagger class="mt-auto flex flex-wrap gap-3 pt-8">
                <a
                    data-modal-demo
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-paper transition-colors hover:bg-accent-deep"
                >
                    <span data-modal-demo-label>Ver demo</span>
                    <ArrowUpRight size={16} aria-hidden="true" />
                </a>
                <a
                    data-modal-github
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 rounded-full border border-line px-5 py-3 transition-colors hover:border-ink"
                >
                    <Icon name="simple-icons:github" aria-hidden="true" size={16} />
                    Código
                </a>
                <span data-modal-private class="flex items-center px-1 text-sm text-muted">Repositorio privado</span>
            </div>
        </div>
    </div>
</dialog>

<script type="application/json" data-projects-json set:html={JSON.stringify(projects)} />

<script>
    import projectAnimation from "../script/project.js"
    projectAnimation()
</script>
