---
import { Icon } from "astro-icon/components";

const skills = [
    {
        name: "Astro",
        icon: "simple-icons:astro"
    },
    {
        name: "React Native",
        icon: "simple-icons:react"
    },
    {
        name: "Node.js",
        icon: "simple-icons:nodedotjs"
    },
    {
        name: "Tailwind CSS",
        icon: "simple-icons:tailwindcss"
    },
    {
        name: "JavaScript",
        icon: "simple-icons:javascript"
    },
    {
        name: "PostgreSQL",
        icon: "simple-icons:postgresql"
    }
];
---

<section
   data-trigger-skills
    class="col-span-1 row-span-auto rounded-xl border bg-white p-6 sm:col-span-2 sm:p-8 lg:col-span-4 lg:row-span-6"
>
    <div class="flex h-full flex-col">
        <span class="text-3xl font-[Story] text-cyan-700 sm:text-4xl">
            03.
        </span>

        <div class="mt-auto grid grid-cols-2 gap-3">
            {
                skills.map((skill) => (
                    <div class="flex items-center gap-2 rounded-3xl border p-2">
                        <Icon
                            name={skill.icon}
                            class="h-5 w-5"
                        />

                        <span>
                            {skill.name}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import skillsLoading from "../script/skills.js";
    skillsLoading()
</script>