---
import Analytics  from '@vercel/analytics/astro'
import '../styles/global.css'

const siteTitle = "Agustín Arla | Analista Funcional & Desarrollador Full Stack"
const siteDescription = "Portfolio de Agustín Arla - Analista Funcional y Desarrollador Full Stack en Córdoba, Argentina. Especializado en React Native, Node.js, PostgreSQL y ciberseguridad."
const siteUrl = "https://porfolio-agustin-weld.vercel.app"
const siteImage = new URL("/images/agusblanco.webp", siteUrl).href
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/images/logoAgus.webp" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={siteDescription} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={siteUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:image" content={siteImage} />
		<meta property="og:locale" content="es_AR" />

		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={siteDescription} />
		<meta name="twitter:image" content={siteImage} />
        
		<meta name="theme-color" content="#f4f2ec" />
		<title>{siteTitle}</title>

		<link rel="preload" href="/fonts/RobotoCondensed-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
		<script is:inline>document.documentElement.classList.add("js")</script>
		<noscript><style>[data-loader], [data-cursor-root] { display: none !important; }</style></noscript>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Agustín Arla",
				"url": "https://porfolio-agustin-weld.vercel.app",
				"jobTitle": "Analista Funcional & Desarrollador Full Stack",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Córdoba",
					"addressCountry": "AR"
				},
				"sameAs": [
					"https://github.com/agustinnarla",
					"https://www.linkedin.com/in/agustinarla/"
				],
				"knowsAbout": [
					"React Native",
					"Node.js",
					"PostgreSQL",
					"JavaScript",
					"TypeScript",
					"Supabase",
					"Tailwind CSS",
					"Astro",
					"GSAP",
					"Ciberseguridad"
				]
			}
		</script>
	</head>
	<body>
		<slot />
		<Analytics />
	</body>
</html>